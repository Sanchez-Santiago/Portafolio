---
// src/components/effect/FloatingMusicPlayer.astro
// Reliable Direct MP3 Links
const songs = [
  {
    url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
    artist: "SoundHelix",
    title: "Galaxy Ambience 1",
  },
  {
    url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3",
    artist: "SoundHelix",
    title: "Celestial Voyage",
  }
];
---

<div class="music-player-container" id="music-container" data-songs={JSON.stringify(songs)}>
  <!-- Collapsed state: Floating Button -->
  <div class="music-trigger" id="music-trigger">
    <div class="pulsating-circle"></div>
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 3V13.55C11.41 13.21 10.73 13 10 13C7.79 13 6 14.79 6 17C6 19.21 7.79 21 10 21C12.21 21 14 19.21 14 17V7H18V3H12Z" fill="currentColor"/>
    </svg>
  </div>

  <!-- Expanded state: Control Panel -->
  <div class="player-panel">
    <div class="track-info">
      <span class="song-title" id="current-title">Galaxy Ambience 1</span>
      <span class="song-artist" id="current-artist">SoundHelix</span>
    </div>

    <div class="main-controls">
      <button id="music-prev-btn" class="control-btn" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19 20L9 12L19 4V20ZM5 19V5H7V19H5Z" fill="currentColor"/></svg>
      </button>
      <button id="play-pause-btn" class="control-btn play-btn" aria-label="Play/Pause">
        <svg id="play-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 5V19L19 12L8 5Z" fill="currentColor"/></svg>
        <svg id="pause-icon" class="hidden" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 19H10V5H6V19ZM14 5V19H18V5H14Z" fill="currentColor"/></svg>
      </button>
      <button id="music-next-btn" class="control-btn" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 4L15 12L5 20V4ZM17 5V19H19V5H17Z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="extra-controls">
      <div class="volume-container">
        <button id="mute-btn" class="mute-btn" aria-label="Mute/Unmute">
          <svg id="vol-unmuted" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 9V15H7L12 20V4L7 9H3ZM16.5 12C16.5 10.23 15.48 8.71 14 7.97V16.02C15.48 15.29 16.5 13.77 16.5 12Z" fill="currentColor"/></svg>
          <svg id="vol-muted" class="hidden" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.5 12C16.5 10.23 15.48 8.71 14 7.97V16.02C15.48 15.29 16.5 13.77 16.5 12ZM19 12C19 15.39 17.07 18.33 14.12 19.71L15.54 21.13C19.16 19.13 21.5 15.34 21.5 11M3 9V15H7L12 20V4L7 9H3ZM16.5 12C16.5 10.23 15.48 8.71 14 7.97V16.02C15.48 15.29 16.5 13.77 16.5 12Z" fill="currentColor"/></svg>
        </button>
        <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="0.05">
      </div>
      <div class="progress-wrap">
        <div class="progress-bg" id="progress-container">
          <div class="progress-fill" id="music-progress"></div>
        </div>
      </div>
    </div>
  </div>

  <audio id="main-audio" src={songs[0].url} loop preload="auto"></audio>
</div>

<script>
  const container = document.getElementById('music-container');
  const songsData = container?.dataset.songs || '[]';
  const songs = JSON.parse(songsData);

  let currentSongIndex = 0;
  const audio = document.getElementById('main-audio') as HTMLAudioElement;
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const nextBtn = document.getElementById('music-next-btn');
  const prevBtn = document.getElementById('music-prev-btn');
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  const progressFill = document.getElementById('music-progress');
  const progressContainer = document.getElementById('progress-container');
  const titleEl = document.getElementById('current-title');
  const artistEl = document.getElementById('current-artist');
  const muteBtn = document.getElementById('mute-btn');
  const volUnmutedIcon = document.getElementById('vol-unmuted');
  const volMutedIcon = document.getElementById('vol-muted');

  let isPlaying = false;
  let isMuted = false;
  let savedVolume = 0.05;

  // Initialize
  if (audio) {
    audio.volume = savedVolume;
    
    // Ensure progress bar is at 0 initially
    if (progressFill) progressFill.style.width = '0%';

    const startAudio = () => {
      audio.play().then(() => {
        isPlaying = true;
        updateUI();
      }).catch(err => {
        console.log("Autoplay blocked, waiting for click");
      });
      // We don't remove if they might click multiple times before it works
    };

    // Try to play on any first interaction (fallback if autoplay fails)
    document.addEventListener('click', startAudio, { once: true });
    document.addEventListener('touchstart', startAudio, { once: true });
    
    // Attempt immediate autoplay on load
    startAudio();
  }

  function updateUI() {
    if (isPlaying) {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
    } else {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
    }

    if (isMuted || audio.volume === 0) {
      volUnmutedIcon.classList.add('hidden');
      volMutedIcon.classList.remove('hidden');
    } else {
      volUnmutedIcon.classList.remove('hidden');
      volMutedIcon.classList.add('hidden');
    }
  }

  function updateSongInfo() {
    titleEl.textContent = songs[currentSongIndex].title;
    artistEl.textContent = songs[currentSongIndex].artist;
    audio.src = songs[currentSongIndex].url;
    audio.load();
    if (isPlaying) {
      audio.play().catch(e => console.log("Load play fail"));
    }
  }

  function togglePlay() {
    if (isPlaying) {
      audio.pause();
    } else {
      audio.play().catch(e => console.log("Toggle play fail"));
    }
    isPlaying = !isPlaying;
    updateUI();
  }

  playPauseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePlay();
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentSongIndex = (currentSongIndex + 1) % songs.length;
    updateSongInfo();
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    currentSongIndex = (currentSongIndex - 1 + songs.length) % songs.length;
    updateSongInfo();
  });

  muteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    isMuted = !isMuted;
    if (isMuted) {
      savedVolume = audio.volume;
      audio.volume = 0;
      if (volumeSlider) volumeSlider.value = "0";
    } else {
      audio.volume = savedVolume > 0 ? savedVolume : 0.3;
      if (volumeSlider) volumeSlider.value = audio.volume.toString();
    }
    updateUI();
  });

  volumeSlider?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const val = parseFloat(target.value);
    audio.volume = val;
    if (val > 0) {
      isMuted = false;
      savedVolume = val;
    } else {
      isMuted = true;
    }
    updateUI();
  });

  audio?.addEventListener('timeupdate', () => {
    if (audio.duration) {
      const percent = (audio.currentTime / audio.duration) * 100;
      if (progressFill) progressFill.style.width = percent + '%';
    }
  });

  // Seek functionality
  progressContainer?.addEventListener('click', (e) => {
    e.stopPropagation();
    const rect = progressContainer.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const width = rect.width;
    const percent = x / width;
    audio.currentTime = percent * audio.duration;
  });
</script>

<style>
  .music-player-container {
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 999999;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .music-trigger {
    width: 56px;
    height: 56px;
    background: rgba(19, 158, 163, 0.4);
    backdrop-filter: blur(12px);
    border: 2px solid rgba(19, 158, 163, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    position: relative;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 0 20px rgba(19, 158, 163, 0.4);
  }

  .pulsating-circle {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(19, 158, 163, 0.3);
    animation: pulsate 2s infinite;
  }

  @keyframes pulsate {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  .player-panel {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 15px 25px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  .music-player-container:hover .player-panel {
    width: 320px;
    opacity: 1;
    pointer-events: auto;
  }

  .music-player-container:hover .music-trigger {
    transform: scale(0.9);
  }

  .track-info { display: flex; flex-direction: column; }
  .song-title { font-size: 1rem; font-weight: 700; color: #fff; }
  .song-artist { font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); }

  .main-controls { display: flex; align-items: center; gap: 20px; }
  .control-btn {
    background: none; border: none; color: #fff; cursor: pointer;
    padding: 8px; border-radius: 50%; display: flex;
    transition: all 0.2s ease;
  }
  .control-btn svg { width: 22px; height: 22px; }
  .control-btn:hover { color: #139ea3; background: rgba(255, 255, 255, 0.1); }

  .extra-controls { display: flex; flex-direction: column; gap: 10px; }
  .volume-container { display: flex; align-items: center; gap: 12px; }
  .mute-btn { background: none; border: none; color: rgba(255, 255, 255, 0.6); cursor: pointer; display: flex; }
  .mute-btn svg { width: 18px; height: 18px; }

  #volume-slider {
    flex: 1; height: 4px; appearance: none;
    background: rgba(255, 255, 255, 0.2); border-radius: 2px; cursor: pointer;
  }
  #volume-slider::-webkit-slider-thumb {
    appearance: none; width: 12px; height: 12px; background: #139ea3; border-radius: 50%;
  }

  .progress-wrap { width: 100%; height: 5px; cursor: pointer; }
  .progress-bg { width: 100%; height: 100%; background: rgba(255, 255, 255, 0.1); border-radius: 3px; position: relative; }
  .progress-fill {
    height: 100%; background: linear-gradient(90deg, #139ea3, #26bb12);
    width: 0%; border-radius: 3px; transition: width 0.1s linear;
  }

  .hidden { display: none; }
  @media (max-width: 768px) {
    .music-player-container { bottom: 20px; left: 20px; }
    .music-player-container:hover .player-panel { width: 260px; }
  }
</style>
