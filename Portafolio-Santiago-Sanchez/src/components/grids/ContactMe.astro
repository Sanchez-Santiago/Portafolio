---
// ContactMe.astro — Con redes sociales destacadas y formulario
const { t } = Astro.props;
---

<div class="contact-wrapper">
  <!-- Header -->
  <div class="contact-header">
    <span class="contact-tag">CONTACTO</span>
    <h2 class="contact-title" data-i18n="ContactMe">{t?.ContactMe || "Contáctame"}</h2>
  </div>

  <!-- Formulario de contacto compacto -->
  <form
    class="contact-form"
    action="https://formsubmit.co/bccb837118903122749568394ce06bb1"
    method="POST"
  >
    <div class="form-row">
      <input type="text" name="name" class="form-input" placeholder="Nombre" required />
      <input type="email" name="email" class="form-input" placeholder="Email" required />
    </div>
    <textarea placeholder="Mensaje..." class="form-input form-textarea" name="message" rows="3" required></textarea>
    <button type="submit" class="submit-btn">
      <span data-i18n="Enviar">{t?.Enviar || "Enviar mensaje"}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
    </button>
    <input type="hidden" name="_next" data-base="https://portafolio-santiago-sanchez.netlify.app" value="https://portafolio-santiago-sanchez.netlify.app/es/" />
    <input type="hidden" name="_captcha" value="false" />
  </form>

  <!-- Redes Sociales compactas (abajo del formulario) -->
  <div class="socials-row">
    <a href="https://github.com/Sanchez-Santiago" target="_blank" rel="noopener" class="social-pill social-github">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span class="social-handle">GitHub</span>
    </a>

    <a href="https://linkedin.com/in/santiago-sanchez-dev" target="_blank" rel="noopener" class="social-pill social-linkedin">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
      <span class="social-handle">LinkedIn</span>
    </a>

    <a href="https://instagram.com/santiago_sanchez.24" target="_blank" rel="noopener" class="social-pill social-instagram">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
      </svg>
      <span class="social-handle">Instagram</span>
    </a>

    <a href="https://facebook.com/profile.php?id=100011906439626" target="_blank" rel="noopener" class="social-pill social-facebook">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      <span class="social-handle">Facebook</span>
    </a>

    <a href="https://discord.com/users/708152038961184779" target="_blank" rel="noopener" class="social-pill social-discord">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
      </svg>
      <span class="social-handle">Discord</span>
    </a>

    <a href="mailto:santiagosanchez.dev@gmail.com" class="social-pill social-mail">
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
      </svg>
      <span class="social-handle">Email</span>
    </a>
  </div>
</div>

<style>
  .contact-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.25rem;
    color: #ffffff;
    max-width: 560px;
    margin: 0 auto;
    width: 100%;
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .contact-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: #555;
    letter-spacing: 1px;
    font-weight: 700;
  }

  .contact-title {
    font-family: 'Teko', sans-serif;
    font-size: 2rem;
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
  }

  /* ── Redes Sociales compactas ── */
  .socials-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.25s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .social-pill:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.04);
  }

  .social-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .social-handle {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #aaa;
    white-space: nowrap;
  }

  /* Colores por red */
  .social-github { color: #e6edf3; }
  .social-github:hover { border-color: #e6edf3; box-shadow: 0 0 10px rgba(230, 237, 243, 0.15); }
  .social-github:hover .social-handle { color: #fff; }

  .social-linkedin { color: #0a66c2; }
  .social-linkedin:hover { border-color: #0a66c2; box-shadow: 0 0 10px rgba(10, 102, 194, 0.3); }
  .social-linkedin:hover .social-handle { color: #0a66c2; }

  .social-instagram { color: #e1306c; }
  .social-instagram:hover { border-color: #e1306c; box-shadow: 0 0 10px rgba(225, 48, 108, 0.3); }
  .social-instagram:hover .social-handle { color: #e1306c; }

  .social-facebook { color: #1877f2; }
  .social-facebook:hover { border-color: #1877f2; box-shadow: 0 0 10px rgba(24, 119, 242, 0.3); }
  .social-facebook:hover .social-handle { color: #1877f2; }

  .social-discord { color: #5865f2; }
  .social-discord:hover { border-color: #5865f2; box-shadow: 0 0 10px rgba(88, 101, 242, 0.3); }
  .social-discord:hover .social-handle { color: #5865f2; }

  .social-mail { color: #00ff66; }
  .social-mail:hover { border-color: #00ff66; box-shadow: 0 0 10px rgba(0, 255, 102, 0.3); }
  .social-mail:hover .social-handle { color: #00ff66; }

  /* ── Formulario ── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .form-input {
    width: 100%;
    padding: 0.7rem 1rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    outline: none;
    transition: border-color 0.3s;
    box-sizing: border-box;
  }

  .form-input::placeholder { color: rgba(255,255,255,0.3); }
  .form-input:focus { border-color: rgba(0,255,102,0.4); }

  .form-textarea {
    resize: none;
    min-height: 70px;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #00ff66;
    border: none;
    border-radius: 10px;
    color: #050505;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.19,1,0.22,1);
  }

  .submit-btn svg { width: 16px; height: 16px; }

  .submit-btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0,255,102,0.15);
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
