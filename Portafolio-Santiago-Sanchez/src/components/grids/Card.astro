---
// Recibir datos a través de props
const { title, content, image, link, technology, i18nTitle, i18nText, i18nTech } = Astro.props;
---

<div class="project-card-container">
  <div class="project-card" data-link={link} data-spotlight>
    {image && (
      <div class="card-image-wrapper">
        <img class="project-image" src={image} alt={title} loading="lazy" />
        <div class="image-overlay"></div>
        <span class="card-tag">PROYECTO</span>
      </div>
    )}
    
    <div class="card-content">
      <div class="header">
        <h2 class="project-title" data-i18n={i18nTitle}>{title}</h2>
        <span class="tech-tag" data-i18n={i18nTech}>{technology}</span>
      </div>
      
      <div class="description-viewport">
        <p class="project-description" data-i18n={i18nText}>{content}</p>
      </div>

      <div class="card-footer">
        <a href={link} class="view-project-btn">
          <span>View Project</span>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Efecto spotlight (mouse-follow) igual a las bento cards
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty("--mouse-x", `${x}%`);
        card.style.setProperty("--mouse-y", `${y}%`);
      });
    });
  });
</script>

<style>
  .project-card-container {
    perspective: 1000px;
    height: 100%;
  }

  .project-card {
    width: 100%;
    height: 100%;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    position: relative;
  }

  /* Spotlight radial al hover (igual a bento) */
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 255, 102, 0.05), transparent 40%);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 255, 102, 0.25);
    box-shadow: 0 20px 50px rgba(0, 255, 102, 0.12);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .project-card:hover .project-image {
    transform: scale(1.08);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(5, 5, 5, 0.75) 0%, rgba(0, 255, 102, 0.04) 55%, transparent 100%);
  }

  .card-tag {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #00ff66;
    background: rgba(5, 5, 5, 0.7);
    border: 1px solid rgba(0, 255, 102, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    backdrop-filter: blur(4px);
    z-index: 3;
  }

  .card-content {
    padding: 1.25rem 1.5rem 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    position: relative;
    z-index: 3;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-title {
    font-family: "Teko", sans-serif;
    font-size: 1.75rem;
    line-height: 1.05;
    color: #fff;
    margin: 0;
    text-transform: uppercase;
  }

  .tech-tag {
    display: inline-flex;
    width: fit-content;
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #00ff66;
    background: rgba(0, 255, 102, 0.05);
    border: 1px solid rgba(0, 255, 102, 0.25);
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
  }

  .description-viewport {
    overflow: hidden;
    position: relative;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .project-description {
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #999999;
    font-weight: 300;
    margin: 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .view-project-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    transition: color 0.3s;
    width: fit-content;
  }

  .view-project-btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.3s;
  }

  .view-project-btn:hover {
    color: #00ff66;
  }

  .view-project-btn:hover svg {
    transform: translate(2px, -2px);
  }
</style>
