---
// Recibir datos a través de props
const { title, content, image, link, technology } = Astro.props;
---

<div class="project-card-container">
  <div class="project-card" data-link={link}>
    <div class="card-image-wrapper">
      <img class="project-image" src={image} alt={title} loading="lazy" />
      <div class="image-overlay"></div>
    </div>
    
    <div class="card-content">
      <div class="header">
        <h2 class="project-title">{title}</h2>
        <div class="tech-tag">{technology}</div>
      </div>
      
      <div class="description-viewport">
        <p class="project-description">{content}</p>
      </div>

      <div class="card-footer">
        <a href={link} class="view-project-btn" data-magnetic>
          <span>View Project</span>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

</script>

<style>
  .project-card-container {
    perspective: 1000px;
    padding: 1rem;
    height: 100%;
  }

  .project-card {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: rgba(19, 158, 163, 0.4);
    box-shadow: 0 20px 50px rgba(19, 158, 163, 0.15);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .project-card:hover .project-image {
    transform: scale(1.1);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.6) 0%, transparent 100%);
  }

  .card-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .project-title {
    font-family: "Teko", sans-serif;
    font-size: 1.8rem;
    line-height: 1.1;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .tech-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #139ea3;
    font-weight: 700;
  }

  .description-viewport {
    max-height: 4.5em;
    overflow: hidden;
    position: relative;
  }

  .project-description {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .view-project-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.3s;
  }

  .view-project-btn svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s;
  }

  .view-project-btn:hover {
    color: #26bb12;
  }

  .view-project-btn:hover svg {
    transform: translate(2px, -2px);
  }
</style>
