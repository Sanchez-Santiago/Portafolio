---
const { t } = Astro.props as any;
---

<div class="contact-wrapper">
  <div class="contact-container">
    <h1 class="section-title">{t?.Contact}</h1>
    <nav class="social-grid">
      <a class="social-tile" href="https://github.com/Sanchez-Santiago" data-magnetic>
        <div class="tile-glass"></div>
        <img
          class="social-icon"
          src="/assets/icons/social/Github_dark.svg"
          alt="Github"
        />
      </a>
      <a class="social-tile" href="https://www.linkedin.com/in/santiago-sanchez-dev/" data-magnetic>
        <div class="tile-glass"></div>
        <img
          class="social-icon"
          src="/assets/icons/social/linkedin.svg"
          alt="LinkedIn"
        />
      </a>
      <a class="social-tile" href="https://www.facebook.com/profile.php?id=100011906439626" data-magnetic>
        <div class="tile-glass"></div>
        <img
          class="social-icon"
          src="/assets/icons/social/facebook.svg"
          alt="Facebook"
        />
      </a>
      <a class="social-tile" href="https://www.instagram.com/santiago_sanchez.24/" data-magnetic>
        <div class="tile-glass"></div>
        <img
          class="social-icon"
          src="/assets/icons/social/Instagram_dark.svg"
          alt="Instagram"
        />
      </a>
      <a class="social-tile" href="https://www.discordapp.com/users/708152038961184779" data-magnetic>
        <div class="tile-glass"></div>
        <img
          class="social-icon"
          src="/assets/icons/social/discord.svg"
          alt="Discord"
        />
      </a>
    </nav>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
</script>

<style>
  .contact-wrapper {
    width: 100%;
    height: 100%;
    padding: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .contact-container {
    width: 100%;
    text-align: center;
  }

  .section-title {
    font-family: "Teko", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.5rem;
    background: linear-gradient(180deg, #fff 0%, rgba(255,255,255,0.4) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .social-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .social-tile {
    position: relative;
    width: 80px;
    height: 80px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .tile-glass {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at top right, rgba(255,255,255,0.05), transparent);
    backdrop-filter: blur(5px);
    z-index: 0;
  }

  .social-tile:hover {
    transform: translateY(-5px);
    border-color: rgba(19, 158, 163, 0.4);
    box-shadow: 0 20px 50px rgba(19, 158, 163, 0.15);
  }

  .social-icon {
    position: relative;
    z-index: 1;
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.3));
  }

  @media (max-width: 480px) {
    .social-tile {
      width: 70px;
      height: 70px;
    }
    .social-icon {
      width: 35px;
      height: 35px;
    }
  }
</style>
</style>
