---
/** Inspiración de: Anne Klapwijk */
const { t } = Astro.props;
---

<div class="habilidades-card">
  <div class="habilidades-header">
    <span class="habilidades-tag" data-i18n="skill.tag">{t?.skill?.tag || "TECNOLOGÍAS"}</span>
    <span class="habilidades-title" data-i18n="skill.title">{t?.skill?.title || "Habilidades"}</span>
  </div>

  <!-- Contenedor del Orbe Giratorio -->
  <div class="orbit-container">
    <div class="orbit">
      <ul class="orbit-wrap">
        <li class="orbit-center">
          <h1 class="orbit-center__text" data-i18n="skill.center">{t?.skill?.center || "Skills"}</h1>
        </li>

        <li>
          <ul class="ring-0">
            <li>
              <img class="orbit-icon" src="/assets/icons/docker.svg" alt="Docker" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/kotlin.svg" alt="Kotlin" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/typescript.svg" alt="TypeScript" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/mariadb.svg" alt="MariaDB" />
            </li>
          </ul>
        </li>

        <li>
          <ul class="ring-1">
            <li>
              <img class="orbit-icon" src="/assets/icons/python.svg" alt="Python" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/c-plusplus.svg" alt="C++" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/linux.svg" alt="Linux" />
            </li>
          </ul>
        </li>

        <li>
          <ul class="ring-2">
            <li>
              <img class="orbit-icon" src="/assets/icons/git.svg" alt="Git" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/css.svg" alt="CSS" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/html5.svg" alt="HTML5" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/Astro_dark.svg" alt="Astro" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/mongodb.svg" alt="MongoDB" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/mysql.svg" alt="MySQL" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/react.svg" alt="React" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/nodejs.svg" alt="NodeJS" />
            </li>
          </ul>
        </li>

        <li>
          <ul class="ring-3">
            <li>
              <img class="orbit-icon" src="/assets/icons/java.svg" alt="Java" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/Rust_dark.svg" alt="Rust" />
            </li>
            <li>
              <img class="orbit-icon" src="/assets/icons/javascript.svg" alt="JavaScript" />
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>

  <!-- Pie de Tarjeta con Chips y Texto -->
  <div class="habilidades-footer">
    <div class="chips-container">
      <span class="tech-chip">Kotlin</span>
      <span class="tech-chip">NestJS</span>
      <span class="tech-chip">Astro</span>
      <span class="tech-chip">SQL</span>
      <span class="tech-chip">Git/Github</span>
      <span class="tech-chip">Blender</span>
      <span class="tech-chip">Docker</span>
      <span class="tech-chip">TypeScript</span>
      <span class="tech-chip">MariaDB</span>
      <span class="tech-chip">Python</span>
      <span class="tech-chip">C++</span>
      <span class="tech-chip">Linux</span>
      <span class="tech-chip">CSS</span>
      <span class="tech-chip">HTML5</span>
      <span class="tech-chip">MongoDB</span>
      <span class="tech-chip">MySQL</span>
      <span class="tech-chip">React</span>
      <span class="tech-chip">NodeJS</span>
      <span class="tech-chip">Java</span>
      <span class="tech-chip">Rust</span>
      <span class="tech-chip">JavaScript</span>
    </div>
    <p class="habilidades-desc" data-i18n="skill.desc">
      {t?.skill?.desc || "Constantemente motivado a ampliar mis horizontes profesionales en el mundo del desarrollo de software."}
    </p>
  </div>
</div>

<style>
  .habilidades-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #ffffff;
    gap: 1rem;
  }

  .habilidades-header {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .habilidades-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: #555555;
    letter-spacing: 1px;
    font-weight: 700;
  }

  .habilidades-title {
    font-family: 'Teko', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
  }

  /* Orbit layout */
  .orbit-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    overflow: hidden;
    height: 320px;
    position: relative;
  }

  .orbit {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(0.9);
  }

  .orbit-wrap {
    position: relative;
    width: 370px;
    height: 370px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .orbit-wrap > li {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  /* Orbit Rings styling */
  ul[class^="ring"] {
    border: 1px solid rgba(0, 255, 102, 0.12);
    position: relative;
    padding: 0;
    margin: 0;
    border-radius: 50%;
    list-style: none;
    box-sizing: content-box;
  }

  ul[class^="ring"] li {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px;
  }

  .orbit-icon {
    width: 40px;
    height: 40px;
    padding: 6px;
    border-radius: 50%;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    object-fit: contain;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .orbit-icon:hover {
    transform: scale(1.4);
    border-color: #00ff66;
    box-shadow: 0 0 10px rgba(0, 255, 102, 0.4);
  }

  /* Ring sizing & animations */
  .ring-0 {
    width: 340px;
    height: 340px;
    animation: clockwiseRotate 45s linear infinite;
  }

  .ring-1 {
    width: 260px;
    height: 260px;
    animation: clockwiseRotate 38s linear infinite;
  }

  .ring-2 {
    width: 200px;
    height: 200px;
    animation: clockwiseRotate 30s linear infinite;
  }

  .ring-3 {
    width: 124px;
    height: 124px;
    animation: clockwiseRotate 22s linear infinite;
  }

  /* Icon positions along the rings */
  .ring-0 > *:nth-of-type(1) { transform: rotate(45deg) translate(170px) rotate(-45deg); }
  .ring-0 > *:nth-of-type(2) { transform: rotate(135deg) translate(170px) rotate(-135deg); }
  .ring-0 > *:nth-of-type(3) { transform: rotate(225deg) translate(170px) rotate(-225deg); }
  .ring-0 > *:nth-of-type(4) { transform: rotate(315deg) translate(170px) rotate(-315deg); }

  .ring-1 > *:nth-of-type(1) { transform: rotate(90deg) translate(130px) rotate(-90deg); }
  .ring-1 > *:nth-of-type(2) { transform: rotate(210deg) translate(130px) rotate(-210deg); }
  .ring-1 > *:nth-of-type(3) { transform: rotate(330deg) translate(130px) rotate(-330deg); }

  .ring-2 > *:nth-of-type(1) { transform: rotate(0deg) translate(100px) rotate(0deg); }
  .ring-2 > *:nth-of-type(2) { transform: rotate(45deg) translate(100px) rotate(-45deg); }
  .ring-2 > *:nth-of-type(3) { transform: rotate(90deg) translate(100px) rotate(-90deg); }
  .ring-2 > *:nth-of-type(4) { transform: rotate(135deg) translate(100px) rotate(-135deg); }
  .ring-2 > *:nth-of-type(5) { transform: rotate(180deg) translate(100px) rotate(-180deg); }
  .ring-2 > *:nth-of-type(6) { transform: rotate(225deg) translate(100px) rotate(-225deg); }
  .ring-2 > *:nth-of-type(7) { transform: rotate(270deg) translate(100px) rotate(-270deg); }
  .ring-2 > *:nth-of-type(8) { transform: rotate(315deg) translate(100px) rotate(-315deg); }

  .ring-3 > *:nth-of-type(1) { transform: rotate(30deg) translate(62px) rotate(-30deg); }
  .ring-3 > *:nth-of-type(2) { transform: rotate(150deg) translate(62px) rotate(-150deg); }
  .ring-3 > *:nth-of-type(3) { transform: rotate(270deg) translate(62px) rotate(-270deg); }

  /* Center element */
  .orbit-center {
    z-index: 5;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #090909;
    border: 2px solid #00ff66;
    box-shadow: 0 0 15px rgba(0, 255, 102, 0.3);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 0.3s ease;
  }

  .orbit-center:hover {
    transform: translate(-50%, -50%) scale(1.1);
    box-shadow: 0 0 20px rgba(0, 255, 102, 0.5);
  }

  .orbit-center__text {
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
    color: #00ff66;
    text-transform: uppercase;
  }

  @keyframes clockwiseRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Footer Section */
  .habilidades-footer {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 0.75rem;
  }

  .chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tech-chip {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.25rem 0.55rem;
    background-color: rgba(0, 255, 102, 0.05);
    border: 1px solid rgba(0, 255, 102, 0.15);
    color: #00ff66;
    border-radius: 6px;
  }

  .habilidades-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #888888;
    margin: 0;
    line-height: 1.4;
    font-weight: 300;
  }
</style>
