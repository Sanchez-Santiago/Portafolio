---
// TerminalStats.astro
---

<div class="terminal-card">
  <div class="terminal-header">
    <span class="terminal-tag">TERMINAL_SYSTEM</span>
    <div class="status-indicator">
      <span class="pulse-dot"></span>
      <span class="status-text">ONLINE</span>
    </div>
  </div>

  <div class="terminal-body font-mono">
    <!-- Reloj ASCII integrado -->
    <div class="clock-center">
      <pre id="hora"></pre>
    </div>

    <div class="terminal-line title-line">
      <span class="prompt">&gt;</span> SYSTEM STATUS REPORT
    </div>
    
    <div class="stats-list">
      <div class="stat-row">
        <span class="stat-label">CPU:</span>
        <span id="cpu-val" class="stat-value text-green">24.81%</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">RAM:</span>
        <span id="ram-val" class="stat-value text-green">7859.98 MB</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">DISK:</span>
        <span class="stat-value text-green">43.18 GB</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">STATUS:</span>
        <span class="stat-value text-green-glow">ONLINE</span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="progress-container">
      <div class="progress-bar-ascii" id="progress-bar-ascii">
        [======&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;] 43%
      </div>
    </div>
  </div>
</div>

<script>
  import { analogoNumeros } from "./ClockDigital";

  function mergeTimeGroups(parts: string[]) {
    // Combina grupos de dígitos (HH, MM, SS) lado a lado con separador ':'
    const groups = parts.map((p: string) => p.split("\n").filter(Boolean));
    const height = groups[0].length;
    let out = "";
    for (let i = 0; i < height; i++) {
      let line = "";
      groups.forEach((g: string[], gi: number) => {
        line += (i < g.length ? g[i] : "") + (gi < groups.length - 1 ? "  :  " : "");
      });
      out += line + "\n";
    }
    return out.trimEnd();
  }

  // Simular fluctuación en tiempo real para simular que está "vivo"
  document.addEventListener("DOMContentLoaded", () => {
    const cpuVal = document.getElementById("cpu-val");
    const ramVal = document.getElementById("ram-val");
    const progressBar = document.getElementById("progress-bar-ascii");
    const horaEl = document.getElementById("hora");

    const updateStats = () => {
      if (cpuVal) {
        // CPU oscila entre 15% y 32%
        const cpu = (15 + Math.random() * 17).toFixed(2);
        cpuVal.innerText = `${cpu}%`;
      }
      if (ramVal) {
        // RAM oscila alrededor de 7850 MB
        const ram = (7820 + Math.random() * 60).toFixed(2);
        ramVal.innerText = `${ram} MB`;
      }
      if (progressBar) {
        // Disco / Almacenamiento se mantiene fijo en un 43% con ligera animación
        const percent = 43;
        const totalSlots = 14;
        const activeSlots = Math.round((percent / 100) * totalSlots);
        const barStr = '='.repeat(activeSlots) + '&nbsp;'.repeat(totalSlots - activeSlots);
        progressBar.innerHTML = `[${barStr}] ${percent}%`;
      }
    };

    const updateClock = () => {
      if (!horaEl) return;
      const ahora = new Date();
      const horas = ahora.getHours();
      const minutos = ahora.getMinutes();
      const segundos = ahora.getSeconds();
      horaEl.innerText = mergeTimeGroups([
        analogoNumeros(horas),
        analogoNumeros(minutos),
        analogoNumeros(segundos),
      ]);
    };

    // Actualizar cada 2 segundos
    setInterval(updateStats, 2000);
    updateStats();

    // Actualizar la hora cada segundo
    setInterval(updateClock, 1000);
    updateClock();
  });
</script>

<style>
  .terminal-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: #00ff66;
    font-family: 'Space Mono', monospace;
    gap: 1.25rem;
  }

  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0, 255, 102, 0.15);
    padding-bottom: 0.5rem;
  }

  .terminal-tag {
    font-size: 0.65rem;
    color: #44b669;
    letter-spacing: 1px;
    font-weight: 700;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 8px #00ff66;
    animation: blink 1.5s infinite;
  }

  .status-text {
    font-size: 0.65rem;
    font-weight: 700;
    color: #00ff66;
  }

  .terminal-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-grow: 1;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Reloj ASCII */
  .clock-center {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  #hora {
    font-family: "Lucida Console", "Monaco", monospace;
    font-size: 0.55rem;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: #00ff66;
    text-shadow: 0 0 6px rgba(0, 255, 102, 0.5);
    white-space: pre;
    background: rgba(0, 255, 102, 0.04);
    border: 1px dashed rgba(0, 255, 102, 0.2);
    border-radius: 8px;
    padding: 0.4rem 0.6rem;
    margin: 0 auto;
    transform: scale(0.9);
    transform-origin: center;
    font-weight: 900;
  }

  .title-line {
    font-weight: 700;
    color: #ffffff;
    font-size: 0.8rem;
  }

  .prompt {
    color: #00ff66;
    margin-right: 0.25rem;
  }

  .stats-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
  }

  .stat-label {
    color: #888888;
  }

  .stat-value {
    font-weight: 700;
  }

  .text-green {
    color: #00ff66;
  }

  .text-green-glow {
    color: #00ff66;
    text-shadow: 0 0 6px rgba(0, 255, 102, 0.4);
  }

  .progress-container {
    margin-top: auto;
    font-size: 0.8rem;
    background-color: rgba(0, 255, 102, 0.03);
    border: 1px dashed rgba(0, 255, 102, 0.2);
    padding: 0.5rem;
    border-radius: 8px;
    text-align: center;
  }

  .progress-bar-ascii {
    white-space: nowrap;
    letter-spacing: 1px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
