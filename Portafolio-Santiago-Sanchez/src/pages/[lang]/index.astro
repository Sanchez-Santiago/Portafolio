---
// src/pages/[lang]/index.astro

import SobreMi from "../../components/grids/SobreMi.astro";
import Layout from "../../layouts/Layout2.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher";
import translationsRaw from "../../locales/translations.json";
const translations = translationsRaw as Record<string, any>;
import Skill from "../../components/grids/Skill.astro";
import Contact from "../../components/grids/Contact.astro";
import DogGrid from "../../components/grids/DogGrid.astro";
import ClockGrid from "../../components/grids/ClockGrid.astro";
import CardsGrid from "../../components/grids/CardsGrid.astro";
import ShootingStar from "../../components/grids/ShootingStar.astro";
import ContactMe from "../../components/grids/ContactMe.astro";
import EarthDay from "../../components/grids/EarthDay.astro";
import Experience from "../../components/grids/Experience.astro";
import FloatingMusicPlayer from "../../components/effect/FloatingMusicPlayer.astro";

// 1. Definir rutas estáticas
export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

// 2. Validación segura de idioma
const { lang = "en" } = Astro.params;
const isValidLang = (l: string): l is string => {
  return Object.hasOwn(translations, l);
};
const currentLang = isValidLang(lang) ? lang : "en";

// 3. Acceso seguro a las traducciones
const t = translations[currentLang];
---

<Layout title="Home_Portafolio">
  <div class="grid">
    <div class="grid-item item-1">
      <SobreMi t={t} />
    </div>
    <div class="grid-item item-14">
      <Skill />
    </div>
    <div class="grid-item item-15">
      <ClockGrid />
    </div>
    <div class="grid-item item-16">
      <DogGrid />
    </div>
    <div class="grid-item item-18">
      <CardsGrid t={t} />
    </div>
    <div class="grid-item item-22">
      <ShootingStar />
    </div>
    <div class="grid-item item-23">
      <Contact t={t} />
    </div>
    <div class="grid-item item-30">
      <Experience t={t} />
    </div>
    <div class="grid-item item-31">
      <EarthDay />
    </div>
    <div class="grid-item item-32">
      <ContactMe t={t} />
    </div>
  </div>

  <FloatingMusicPlayer />

  <div class="language-switcher" data-magnetic>
    <LanguageSwitcher currentLang={currentLang} />
  </div>
</Layout>

<script>
  import { gsap } from "gsap";

  const initAnimations = () => {
    // Animación de entrada escalonada para TODOS los items - Versión Rápida
    const entranceTargets = ".grid-item";
    
    gsap.from(entranceTargets, {
      duration: 0.6,
      y: 20,
      opacity: 0,
      stagger: 0.05,
      ease: "power2.out",
      delay: 0.1,
      clearProps: "all"
    });

    // Spotlight Border Glow Effect
    const items = document.querySelectorAll(".grid-item") as NodeListOf<HTMLElement>;
    items.forEach(item => {
      item.addEventListener("mousemove", (e) => {
        const rect = item.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        item.style.setProperty("--x", `${x}px`);
        item.style.setProperty("--y", `${y}px`);
      });
    });

    // Magnetic Effect for Buttons/Icons
    const magneticElements = document.querySelectorAll("[data-magnetic]") as NodeListOf<HTMLElement>;
    magneticElements.forEach(el => {
      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - (rect.left + rect.width / 2);
        const y = e.clientY - (rect.top + rect.height / 2);
        
        gsap.to(el, {
          x: x * 0.3,
          y: y * 0.3,
          duration: 0.4,
          ease: "power2.out"
        });
      });

      el.addEventListener("mouseleave", () => {
        gsap.to(el, {
          x: 0,
          y: 0,
          duration: 0.6,
          ease: "elastic.out(1, 0.3)"
        });
      });
    });
  };

  // Inicialización robusta
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimations);
  } else {
    initAnimations();
  }
</script>

<style>
  /* Estilos globales */
  body {
    margin: 0;
    padding: 0;
    background-color: #000; /* Fondo negro */
    color: #fff; /* Texto en blanco */
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  
  h1, h2, h3 {
    font-family: 'Teko', sans-serif;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .language-switcher {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 999999;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #fff;
    padding: 0;
    border-radius: 14px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  .language-switcher:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(19, 158, 163, 0.4);
    transform: translateY(-2px);
  }

  /* Language Switcher Inner Styles (React Component) */
  :global(.language-switcher-wrapper) {
    display: flex;
    align-items: center;
  }

  :global(.lang-link) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }

  :global(.lang-flag) {
    font-size: 1.3rem;
  }

  /* Contenedor de la cuadrícula */
  .grid {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    grid-template-rows: repeat(16, minmax(130px, auto));
    gap: 20px;
    padding: 2rem;
    max-width: 1400px;
    margin: 40px auto;
  }

  /* Estilos comunes para los elementos de la cuadrícula - Bento Glass Effect */
  .grid-item {
    position: relative;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 1.5rem;
    color: #fff;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    overflow: hidden; /* Necesario para el spotlight que sobresale */
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    opacity: 1;
  }

  .grid-item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle 250px at var(--x, 50%) var(--y, 50%),
      rgba(19, 158, 163, 0.15),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .grid-item:hover::before {
    opacity: 1;
  }

  /* Permitir que los componentes magnéticos sobresalgan un poco si es necesario, 
     pero sin romper la estructura. Por ahora mantenemos hidden para seguridad. */
  .item-18, .item-30 {
    padding: 0; /* Estos componentes manejan su propio espacio interno */
  }

  .grid-item:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(19, 158, 163, 0.3);
    box-shadow: 0 10px 30px 0 rgba(0, 0, 0, 0.5);
  }

  /* Posiciones específicas actualizadas para mayor impacto visual */
  .item-1 {
    grid-column: 1 / span 5;
    grid-row: 1 / span 3;
    background: linear-gradient(135deg, rgba(38, 187, 18, 0.1), rgba(19, 158, 163, 0.1));
  }
  
  .item-14 {
    grid-column: 6 / span 4;
    grid-row: 1 / span 3;
  }

  .item-15 {
    grid-column: 10 / span 2;
    grid-row: 1 / span 2;
  }

  .item-16 {
    grid-column: 10 / span 2;
    grid-row: 3 / span 1;
  }

  /* Projects Grid - Aumentar espacio */
  .item-18 {
    grid-column: 1 / span 10;
    grid-row: 4 / span 5; /* Aumentado de 4 a 5 */
  }

  .item-22 {
    grid-column: 11 / span 1;
    grid-row: 4 / span 5;
  }

  .item-23 {
    grid-column: 1 / span 5;
    grid-row: 9 / span 2; /* Aumentado */
  }

  /* Experience - Aumentar espacio para tarjetas de 450px */
  .item-30 {
    grid-column: 6 / span 6;
    grid-row: 9 / span 4; /* Aumentado de 2 a 4 */
  }

  .item-31 {
    grid-column: 1 / span 5;
    grid-row: 11 / span 4;
  }

  .item-32 {
    grid-column: 6 / span 6;
    grid-row: 13 / span 3;
  }

  /* Media Queries más específicos y controlados */
  /* Media Queries más específicos y controlados */
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(8, 1fr);
      grid-template-rows: repeat(16, minmax(100px, auto));
    }

    .item-1 {
      grid-column: 1 / span 4;
      grid-row: 1 / span 3;
    }

    .item-14 {
      grid-column: 5 / span 4;
      grid-row: 1 / span 3;
    }

    .item-15 {
      grid-column: 1 / span 2;
      grid-row: 4 / span 2;
    }

    .item-16 {
      grid-column: 3 / span 6;
      grid-row: 4 / span 1;
    }

    .item-18 {
      grid-column: 1 / span 7;
      grid-row: 6 / span 5; /* Aumentado */
    }

    .item-22 {
      grid-column: 8 / span 1;
      grid-row: 6 / span 5;
    }

    .item-23 {
      grid-column: 1 / span 4;
      grid-row: 11 / span 2; /* Aumentado */
    }

    .item-30 {
      grid-column: 5 / span 4;
      grid-row: 11 / span 4; /* Aumentado */
    }

    .item-31 {
      grid-column: 1 / span 4;
      grid-row: 13 / span 4;
    }

    .item-32 {
      grid-column: 5 / span 4;
      grid-row: 15 / span 3;
    }
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(30, minmax(100px, auto));
    }

    .item-1 {
      grid-column: 1 / span 4;
      grid-row: 1 / span 3;
    }

    .item-14 {
      grid-column: 1 / span 4;
      grid-row: 4 / span 3;
    }

    .item-15 {
      grid-column: 1 / span 2;
      grid-row: 7 / span 2;
    }

    .item-16 {
      grid-column: 3 / span 2;
      grid-row: 7 / span 2;
    }

    .item-18 {
      grid-column: 1 / span 4;
      grid-row: 9 / span 6; /* Aumentado */
    }

    .item-22 {
      grid-column: 1 / span 4;
      grid-row: 15 / span 1;
    }

    .item-23 {
      grid-column: 1 / span 4;
      grid-row: 16 / span 2; /* Aumentado */
    }

    .item-30 {
      grid-column: 1 / span 4;
      grid-row: 18 / span 4; /* Aumentado */
    }

    .item-31 {
      grid-column: 1 / span 4;
      grid-row: 22 / span 3;
    }

    .item-32 {
      grid-column: 1 / span 4;
      grid-row: 25 / span 4; /* Aumentado */
    }
  }
</style>
