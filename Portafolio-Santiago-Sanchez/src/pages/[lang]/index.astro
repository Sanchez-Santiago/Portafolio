---
import Layout from "../../layouts/Layout.astro";
import SobreMi from "../../components/grids/SobreMi.astro";
import Skill from "../../components/grids/Skill.astro";
import TerminalStats from "../../components/grids/TerminalStats.astro";
import Mascota from "../../components/grids/Mascota.astro";
import Ubicacion from "../../components/grids/Ubicacion.astro";
import Experience from "../../components/grids/Experience.astro";
import ContactMe from "../../components/grids/ContactMe.astro";
import CardsGrid from "../../components/grids/CardsGrid.astro";

import translationsData from "../../locales/translations.json";

export function getStaticPaths() {
  return [
    { params: { lang: "es" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params;
const translations = translationsData as Record<string, any>;
const t = translations[lang as string] ?? translations["es"];
const currentLang = lang as string;
---

<Layout title={`Santiago Sanchez | ${lang === "en" ? "Portfolio" : "Portafolio"}`}>
  <div class="portfolio-container">
    
    <!-- NAV -->
    <nav class="bento-nav">
      <div class="nav-logo">
        <span class="nav-bracket">&lt;/&gt;</span>
        <span class="nav-name">SS</span>
      </div>
      <div class="nav-links">
        <a href="#proyectos" class="nav-link" data-i18n="nav.projects">{t.nav.projects}</a>
        <a href="#experiencia" class="nav-link" data-i18n="nav.experience">{t.nav.experience}</a>
        <a href="#contacto" class="nav-link" data-i18n="nav.contact">{t.nav.contact}</a>
      </div>
      <div class="nav-actions">
        <button id="lang-toggle" class="lang-toggle" type="button" aria-label="Switch language">
          <span id="lang-toggle-label">{lang === "en" ? "ES" : "EN"}</span>
        </button>
      </div>
    </nav>

    <!-- BENTO GRID -->
    <main class="bento-grid">

      <!-- ROW 1: SobreMi (large) + Terminal Stats (small) + Mascota (small) -->
      <div class="bento-card card-sobre-mi">
        <SobreMi t={t} />
      </div>

      <div class="bento-card card-terminal">
        <TerminalStats />
      </div>

      <div class="bento-card card-mascota">
        <Mascota t={t} />
      </div>

      <!-- ROW 2: Habilidades (medium) + Ubicacion (medium) -->
      <div class="bento-card card-skills">
        <Skill />
      </div>

      <div class="bento-card card-ubicacion">
        <Ubicacion />
      </div>

      <!-- ROW 3: Proyectos (full width) -->
      <div id="proyectos" class="bento-card card-proyectos">
        <CardsGrid t={t} lang={currentLang} />
      </div>

      <!-- ROW 4: Experiencia (large) + Contacto (medium) -->
      <div id="experiencia" class="bento-card card-experiencia">
        <Experience t={t} />
      </div>

      <div id="contacto" class="bento-card card-contacto">
        <ContactMe t={t} />
      </div>

    </main>

    <!-- FOOTER -->
    <footer class="bento-footer">
      <span class="footer-text">
        <span data-i18n="footer.text">{t.footer.text}</span> <span class="green-text" data-i18n="footer.code">{t.footer.code}</span>
      </span>
      <div class="social-links">
        <a href="https://github.com/Sanchez-Santiago" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="https://linkedin.com/in/santiago-sanchez-dev" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </footer>

  </div>
</Layout>

<style>
  /* ===========================
     CONTAINER & LAYOUT
  =========================== */
  .portfolio-container {
    min-height: 100vh;
    background-color: #050505;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    padding: 0 1.5rem 3rem;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* ===========================
     NAV
  =========================== */
  .bento-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    margin-bottom: 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
  }

  .nav-bracket {
    color: #00ff66;
    font-size: 1.2rem;
  }

  .nav-name {
    font-size: 1.1rem;
    letter-spacing: 2px;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: #666666;
    text-decoration: none;
    letter-spacing: 1px;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .lang-toggle {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: #00ff66;
    border: 1px solid rgba(0, 255, 102, 0.3);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .lang-toggle:hover {
    background-color: rgba(0, 255, 102, 0.1);
  }

  /* ===========================
     BENTO GRID
  =========================== */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: auto;
    gap: 1rem;
  }

  /* ===========================
     BENTO CARDS BASE
  =========================== */
  .bento-card {
    background-color: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-sizing: border-box;
  }

  .bento-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(0, 255, 102, 0.025), transparent 40%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  .bento-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* Children above the glow overlay */
  .bento-card > * {
    position: relative;
    z-index: 1;
  }

  /* ===========================
     CARD GRID POSITIONS
  =========================== */
  /* ROW 1 */
  .card-sobre-mi   { grid-column: span 5; min-height: 380px; }
  .card-terminal   { grid-column: span 4; min-height: 380px; }
  .card-mascota    { grid-column: span 3; min-height: 380px; }

  /* ROW 2 */
  .card-skills     { grid-column: span 7; min-height: 400px; }
  .card-ubicacion  { grid-column: span 5; min-height: 400px; }

  /* ROW 3 */
  .card-proyectos  { grid-column: span 12; padding: 2rem; }

  /* ROW 4: Experiencia (full width) */
  .card-experiencia { grid-column: span 12; min-height: 400px; }

  /* ROW 5: Contacto (full width, debajo) */
  .card-contacto    { grid-column: span 12; min-height: auto; }

  /* ===========================
     FOOTER
  =========================== */
  .bento-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .footer-text {
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: #555555;
  }

  .green-text {
    color: #00ff66;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    color: #555555;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
  }

  .social-link:hover {
    color: #00ff66;
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  /* ===========================
     RESPONSIVE
  =========================== */
  @media (max-width: 1100px) {
    .card-sobre-mi   { grid-column: span 6; }
    .card-terminal   { grid-column: span 6; }
    .card-mascota    { grid-column: span 6; }
    .card-skills     { grid-column: span 6; }
    .card-ubicacion  { grid-column: span 6; }
    .card-experiencia { grid-column: span 12; }
    .card-contacto    { grid-column: span 12; }
  }

  @media (max-width: 768px) {
    .portfolio-container {
      padding: 0 1rem 2rem;
    }
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .card-sobre-mi,
    .card-terminal,
    .card-mascota,
    .card-skills,
    .card-ubicacion,
    .card-proyectos,
    .card-experiencia,
    .card-contacto {
      grid-column: span 1;
    }
    .nav-links {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ translationsData, currentLang }}>
  // Spotlight effect: tracks mouse per card
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".bento-card");

    cards.forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty("--mouse-x", x + "%");
        card.style.setProperty("--mouse-y", y + "%");
      });
    });
  });

  // ── Cambio de idioma sin recarga (SPA in-place) ──
  let activeLang = currentLang || "es";

  function getValue(lang, key) {
    let node = translationsData[lang];
    for (const part of key.split(".")) {
      if (node == null) return undefined;
      node = node[part];
    }
    return typeof node === "string" ? node : undefined;
  }

  function applyLang(lang, push) {
    const t = translationsData[lang] || translationsData["es"];
    activeLang = lang;

    // html lang + título
    document.documentElement.setAttribute("lang", lang);
    document.title = lang === "en" ? "Santiago Sanchez | Portfolio" : "Santiago Sanchez | Portafolio";

    // Textos simples con data-i18n
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      const value = getValue(lang, key);
      if (value != null) el.textContent = value;
    });

    // Frases del rotador (TextScramel)
    const scramble = document.querySelector(".scramble-text");
    if (scramble) {
      scramble.dispatchEvent(new CustomEvent("scramble:set", {
        detail: { phrases: t.phrases || [] },
      }));
    }

    // Campo oculto _next del formulario de contacto
    const nextInput = document.querySelector('input[name="_next"]');
    if (nextInput) {
      const base = nextInput.getAttribute("data-base") || "https://portafolio-santiago-sanchez.netlify.app";
      nextInput.value = base + "/" + lang + "/";
    }

    // Etiqueta del toggle (EN<->ES según idioma destino)
    const toggleLabel = document.getElementById("lang-toggle-label");
    if (toggleLabel) toggleLabel.textContent = lang === "en" ? "ES" : "EN";
    const toggleBtn = document.getElementById("lang-toggle");
    if (toggleBtn) toggleBtn.setAttribute("aria-label", lang === "en" ? "Cambiar a español" : "Switch to English");

    if (push) history.pushState({}, "", "/" + lang);
  }

  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("lang-toggle");
    if (toggle) {
      toggle.addEventListener("click", () => {
        const next = activeLang === "en" ? "es" : "en";
        applyLang(next, true);
      });
    }

    // Soporte para back/forward del navegador
    window.addEventListener("popstate", () => {
      const next = location.pathname.startsWith("/en") ? "en" : "es";
      applyLang(next, false);
    });
  });
</script>
